<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AsusDisplayControl</RootNamespace>
    <AssemblyName>ASUS-Display-Control</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>2.2.2</Version>
    <Product>ASUS Display Control</Product>
    <Company>ctnkyaumt</Company>
    <Deterministic>true</Deterministic>
    <!-- Trimming is unsafe for WinForms; keep it off. Self-contained/single-file are
         passed at publish time (see build.ps1) so plain `dotnet build`/`run` stay fast. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Low-memory tuning. The heap here is tiny and the app is idle most of the time, so
         workstation GC without a background collector is both smaller and sufficient; ICU
         and EventSource are dead weight for a monitor control panel. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the GC frugal rather than fast: it may return memory to the OS eagerly and
         should not hold on to virtual memory it no longer needs. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon, embedded so the form + tray can load it at runtime. -->
    <EmbeddedResource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the ASUS CLI next to the app (extracted from cli/windows/dwc_win.zip). -->
    <Content Include="..\cli\windows\dwc\**\*.*"
             Link="cli\windows\dwc\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
